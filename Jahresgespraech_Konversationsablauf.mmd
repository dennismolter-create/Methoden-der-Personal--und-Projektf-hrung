```mermaid
%% Mermaid-Diagramm: Ablauf der Konversation im Jahresgespräch
%% Format: Sequence Diagram (Zeitverlauf von oben nach unten)
%% Teilnehmer: Führungskraft (FK) und Mitarbeiter:in (MA)

sequenceDiagram
    participant FK as Führungskraft
    participant MA as Mitarbeiter:in
    
    %% --- PHASE 1: Begrüßung & Einstieg ---
    Note over FK,MA: 📅 Phase 1: Begrüßung & Einstieg (5–10 Min.)
    FK->>MA: Begrüßung (Small Talk)
    FK->>MA: Agenda & Zeitrahmen vorstellen
    FK->>MA: Betonung der Wichtigkeit
    FK->>MA: Hinweis auf Vertraulichkeit
    
    %% --- PHASE 2: Rückblick ---
    Note over FK,MA: 📊 Phase 2: Rückblick (20–25 Min.)
    FK->>MA: Bittet um Selbstbewertung
    MA->>FK: Präsentation eigener Erfolge/Herausforderungen
    FK->>MA: Gibt Feedback zu Leistung & Zielerreichung
    alt Unterschiedliche Perspektiven
        MA->>FK: Klärungsfragen stellen
        FK->>MA: Erklärungen & Beispiele nennen
    end
    Note over FK,MA: Gemeinsame Einschätzung von Stärken & Potenzialen
    
    %% --- PHASE 3: Zielvereinbarung ---
    Note over FK,MA: 🎯 Phase 3: Zielvereinbarung (20 Min.)
    FK->>MA: Vorstellt Unternehmens-/Teamziele
    FK->>MA: Frag nach eigenen Zielvorschlägen
    MA->>FK: Nennt persönliche Ziele
    loop SMART-Formulierung
        FK->>MA: Prüft auf Spezifität/Messbarkeit
        MA->>FK: Passt Ziele an
    end
    Note over FK,MA: Einigung auf 3–5 Hauptziele
    
    %% --- PHASE 4: Entwicklungsplanung ---
    Note over FK,MA: 🌱 Phase 4: Entwicklungsplanung (15 Min.)
    FK->>MA: Frag nach Entwicklungswünschen
    MA->>FK: Nennt Skills/Projekte
    FK->>MA: Schlägt Maßnahmen vor (Schulungen, Mentoring etc.)
    MA->>FK: Äußert Bedarf (Ressourcen, Budget)
    Note over FK,MA: Vereinbarung konkreter Maßnahmen
    
    %% --- PHASE 5: Feedback & Austausch ---
    Note over FK,MA: 💬 Phase 5: Feedback (10–15 Min.)
    FK->>MA: Gibt konstruktives Feedback (SBI-Methode)
    MA->>FK: Reagiert & stellt Nachfragen
    MA->>FK: Gibt Feedback an FK (z. B. Führung, Unterstützung)
    FK->>MA: Bedankt sich für Feedback
    
    %% --- PHASE 6: Zusammenfassung ---
    Note over FK,MA: 📝 Phase 6: Protokoll (5–10 Min.)
    FK->>MA: Fasst Vereinbarungen zusammen
    MA->>FK: Bestätigt oder korrigiert Punkte
    FK->>MA: Liest Protokoll vor
    MA->>FK: Unterschreibt Protokoll
    FK->>FK: Unterschreibt Protokoll
    
    %% --- PHASE 7: Abschluss ---
    Note over FK,MA: 🤝 Phase 7: Abschluss (5 Min.)
    FK->>MA: Dank für das Gespräch
    FK->>MA: Betont Wertschätzung
    FK->>MA: Vereinbart Follow-up (z. B. Quartalscheck)
    MA->>FK: Verabschiedung
    
    %% --- Styling ---
    %% Phasen-Hintergründe
    rect rgba(255, 220, 220, 0.2)  %% Rötlich für Einstieg/Abschluss
        FK->>MA: Begrüßung (Small Talk)
        FK->>MA: Agenda & Zeitrahmen vorstellen
        FK->>MA: Betonung der Wichtigkeit
        FK->>MA: Hinweis auf Vertraulichkeit
        FK->>MA: Dank für das Gespräch
        FK->>MA: Betont Wertschätzung
        FK->>MA: Vereinbart Follow-up (z. B. Quartalscheck)
        MA->>FK: Verabschiedung
    end
    
    rect rgba(220, 220, 255, 0.2)  %% Blau für Hauptphasen
        FK->>MA: Bittet um Selbstbewertung
        MA->>FK: Präsentation eigener Erfolge/Herausforderungen
        FK->>MA: Gibt Feedback zu Leistung & Zielerreichung
        alt Unterschiedliche Perspektiven
            MA->>FK: Klärungsfragen stellen
            FK->>MA: Erklärungen & Beispiele nennen
        end
        FK->>MA: Vorstellt Unternehmens-/Teamziele
        FK->>MA: Frag nach eigenen Zielvorschlägen
        MA->>FK: Nennt persönliche Ziele
        loop SMART-Formulierung
            FK->>MA: Prüft auf Spezifität/Messbarkeit
            MA->>FK: Passt Ziele an
        end
        FK->>MA: Frag nach Entwicklungswünschen
        MA->>FK: Nennt Skills/Projekte
        FK->>MA: Schlägt Maßnahmen vor (Schulungen, Mentoring etc.)
        MA->>FK: Äußert Bedarf (Ressourcen, Budget)
        FK->>MA: Gibt konstruktives Feedback (SBI-Methode)
        MA->>FK: Reagiert & stellt Nachfragen
        MA->>FK: Gibt Feedback an FK (z. B. Führung, Unterstützung)
        FK->>MA: Fasst Vereinbarungen zusammen
        MA->>FK: Bestätigt oder korrigiert Punkte
        FK->>MA: Liest Protokoll vor
        MA->>FK: Unterschreibt Protokoll
        FK->>FK: Unterschreibt Protokoll
    end
```

